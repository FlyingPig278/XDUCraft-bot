DRIVER=~fastapi
COMMAND_START=["/"]

# ============================================================================
# MC 状态图外观（xducraft_mc_status）
# 全部可选，删掉就用默认值。改完需要重启机器人。
# 调参数不用发命令试：python scripts/preview_mc_status.py 直接出图。
# ============================================================================

# 顶栏品牌行。留空则不画这一行，整张图跟着变矮。支持 § 颜色码。
MCS_BRAND=XDUCRAFT
# 图片主标题。留空则不画。支持 § 颜色码，例如 §bXDU§fCRAFT 状态
MCS_TITLE=Minecraft 服务器状态
# 底部渐变压角里的署名。留空则不画。支持 § 颜色码。
MCS_CREDIT=Powered by §7FlyingPig278, LITTLE-UNIkeEN, and KrLite
# 底部右侧是否显示生成时间。署名、生成时间和群公告都没有时，压角整段省略。
MCS_SHOW_GENERATED_AT=true

# 背景方块材质，取自 resources/textures/。渲染器会按每张材质自身的亮度动态
# 计算黑色叠层，让竹板砖、泥土、黑色混凝土粉末等最终保持接近的暗度：
#   留空      按群号稳定挑一张——同一个群每次都是同一张背景
#   random    每次出图随机换一张
#   none      不铺材质，只留纯黑底
#   stone.png 等具体文件名
MCS_TEXTURE=

# 画布逻辑宽度，夹在 640–1600。854 是 Minecraft 的默认窗口宽度。
MCS_WIDTH=854
# 逻辑单位到物理像素的倍率，只接受 2 或 4。
# 奇数倍率会让像素字体偏离 8px / 12px 网格，字形被插值糊掉。
MCS_SCALE=2
# 图片最小逻辑高度。480 是 Minecraft 默认窗口高度（参考项目的做法）；
# 只挂一两台服务器时会拖着一大片空背景，填 0 就贴着内容收边。
MCS_MIN_HEIGHT=480
