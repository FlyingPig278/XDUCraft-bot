DRIVER=~fastapi
COMMAND_START=["/"]

# ============================================================================
# MC 状态图外观（xducraft_mc_status）
# 全部可选，删掉就用默认值。改完需要重启机器人。
# 调参数可在 MC 状态插件仓库运行 scripts/preview_mc_status.py 离线出图。
# ============================================================================

# 顶栏品牌行。留空则不画这一行，整张图跟着变矮。支持 § 颜色码。
MCS_BRAND=XDUCRAFT
# 图片主标题。留空则不画。支持 § 颜色码，例如 §bXDU§fCRAFT 状态
MCS_TITLE=Minecraft 服务器状态
# 底部渐变压角里的署名。留空则不画。支持 § 颜色码。
MCS_CREDIT=Powered by §7FlyingPig278, LITTLE-UNIkeEN, and KrLite
# 底部右侧是否显示生成时间。署名、生成时间和群公告都没有时，压角整段省略。
MCS_SHOW_GENERATED_AT=true

# 背景方块材质，取自 resources/textures/。渲染器会按每张材质自身的亮度动态
# 计算黑色叠层，让竹板砖、泥土、黑色混凝土粉末等最终保持接近的暗度：
#   留空      按群号稳定挑一张——同一个群每次都是同一张背景
#   random    每次出图随机换一张
#   none      不铺材质，只留纯黑底
#   stone.png 等具体文件名
MCS_TEXTURE=

# 默认宽度兼顾移动端与横向信息；可在 480–1600 范围内调整。
MCS_WIDTH=640
# 逻辑单位到物理像素的倍率，只接受 2 或 4。
# 奇数倍率会让像素字体偏离 8px / 12px 网格，字形被插值糊掉。
MCS_SCALE=2
# 图片最小逻辑高度。480 是 Minecraft 默认窗口高度（参考项目的做法）；
# 只挂一两台服务器时会拖着一大片空背景，填 0 就贴着内容收边。
MCS_MIN_HEIGHT=480

# ============================================================================
# 邀请码发放（xducraft_invite）
# 密钥只填写在实际部署环境；插件首次开放前由 SUPERUSER 私聊执行 /invite init。
# ============================================================================
INVITE_GROUP_ID=0
INVITE_API_URL=https://www.xducraft.cn/api/invitation-codes/generate
INVITE_API_SECRET=

# ============================================================================
# 自动接受好友申请（xducraft_auto_friend）
# JSON 数组；只允许这些群的当前成员触发。先开启插件全局总开关，
# 再通过网页或 /功能 on 自动加好友 开启对应群。
# OneBot v11 的好友申请事件没有来源群号，插件会实时查询申请人的群成员身份。
# ============================================================================
AUTO_ACCEPT_FRIEND_GROUP_IDS=[]

# ============================================================================
# 本地网页管理（xducraft_admin），默认关闭；只监听 127.0.0.1
# Git 版本与 wheel 均内置网页；只有修改 Admin 前端时才需要 Node.js 重新构建。
# WEB_ADMIN_PASSWORD 不写到本文件：只在机器人进程的系统环境中设置，至少12字符。
# 口令持有者拥有全部管理权限；远程访问使用 SSH 隧道，不公开面板端口。
# ============================================================================
WEB_ADMIN_ENABLED=false
WEB_ADMIN_PORT=8765
