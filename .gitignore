# ------------------------------------
# 敏感信息和私有数据
# ------------------------------------
# 实际运行时的环境配置文件，通常包含 QQ 号或密钥等
.env
.env.*
!.env.example
!.env.prod.example
!**/.env.example

# 插件运行时产生的数据，如缓存、图片输出、数据库文件
**/data/*
 # 保留json样例
!**/data/*.example

# 插件运行时产生的缓存
**/image_cache/

# ------------------------------------
# Python 运行时生成的文件
# ------------------------------------
# 虚拟环境目录
.venv/
*.py[cod]
*$py.class
.ruff_cache/
.mypy_cache/
.pyright/

# ------------------------------------
# IDE/编辑器/操作系统生成的文件
# ------------------------------------
# PyCharm/IntelliJ IDEA
.idea/

# VS Code
.vscode/

# Claude Code 本机权限配置
.claude/settings.local.json

# 操作系统文件
.DS_Store
Thumbs.db
Desktop.ini

# ------------------------------------
# 测试和构建缓存
# ------------------------------------
.pytest_cache/
__pycache__/
.coverage
.coverage.*
coverage.xml
htmlcov/

# 构建与本地工具输出
build/
dist/
*.egg-info/
node_modules/
/output/
/.playwright-cli/

# mcs-editor 使用自己的 Git 仓库管理
/mcs-editor/

**/App.vue
!/webui/src/App.vue

bot.py

# 注意写成 tests/* 而不是 tests/：Git 不会进入被排除的**目录**，写成后者的话
# 下面的 ! 例外永远不会生效。
tests/*
# 但状态图的不变量测试要跟着代码一起走：像素网格字号、中日韩字体回退这些东西
# 一旦坏掉不会报任何错，只会悄悄糊掉或者变成豆腐块，必须有测试守着。
!tests/conftest.py
!tests/test_status_render.py
!tests/test_web_admin_api.py
!tests/test_web_admin_config.py
!tests/test_keyword_codec.py
!tests/test_wordcloud_commands.py
!tests/test_invite_handlers.py
!tests/test_wordcloud_data_manager.py
!tests/test_pig_logic.py
!tests/test_anti_recall.py
!tests/test_native_configuration.py
!tests/test_keyword_reply.py
!tests/test_mc_status_data_manager.py
!tests/test_auto_friend.py
!tests/test_feature_commands.py
!tests/test_mc_logic.py
!tests/test_mc_status_fetcher.py
!tests/test_mc_status_handlers.py
!tests/test_data_paths.py
!tests/test_data_migration.py

# 预览脚本的出图产物
/preview/
