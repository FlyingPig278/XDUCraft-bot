{
    // 所有没有群级覆盖的群都会继承这里的状态查询源和自建后端地址。
    "__global__": {
        "status_api_source": "auto",
        "status_api_url": ""
    },
    "123456789": {
        "servers": [
            {
                "ip": "hub.example.com",
                "tag": "大厅",
                "tag_color": "3181d0",
                "priority": 1,
                "auth_mode": "mua",
                "children": [
                    {
                        "ip": "survival.example.com:25566",
                        "tag": "生存",
                        "tag_color": "da3c8f",
                        "priority": 2,
                        "auth_mode": "xdu",
                        "children": []
                    }
                ]
            },
            {
                "ip": "modpack.independent.net:25570",
                "tag": "模组",
                "tag_color": "dd6d1e",
                "priority": 3,
                "ignore_in_list": false,
                "hide_ip": false,
                "display_name": "",
                "auth_mode": "offline",
                "children": []
            }
        ],
        "footer": "这是一个示例页脚，请替换为群公告。",
        "show_offline_by_default": false,
        "status_api_source": "",
        "status_api_url": "",
        "default_auth_mode": "",
